{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/davidsneighbour/image-dedup/schemas/report.schema.json",
  "title": "image-origin JSON report",
  "description": "Machine-readable audit report produced by `image-origin report` (PLAN.md §19). Hand-maintained alongside src/reporting/json-report.ts's zod schema, which is the authoritative runtime validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "toolVersion",
    "configFingerprint",
    "config",
    "summary",
    "images",
    "groups",
    "errors"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "toolVersion": { "type": "string", "minLength": 1 },
    "configFingerprint": { "type": "string", "minLength": 1 },
    "repositoryRoot": { "type": "string", "minLength": 1 },
    "config": {
      "type": "object",
      "description": "The fully-resolved image-origin configuration used for this audit. See PLAN.md §4 for its authoritative shape."
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesDiscovered",
        "filesInspected",
        "exactDuplicateGroups",
        "visualGroups",
        "manualReviewGroups",
        "ambiguousGroups",
        "automaticRecommendations",
        "errors"
      ],
      "properties": {
        "filesDiscovered": { "type": "integer", "minimum": 0 },
        "filesInspected": { "type": "integer", "minimum": 0 },
        "exactDuplicateGroups": { "type": "integer", "minimum": 0 },
        "visualGroups": { "type": "integer", "minimum": 0 },
        "manualReviewGroups": { "type": "integer", "minimum": 0 },
        "ambiguousGroups": { "type": "integer", "minimum": 0 },
        "automaticRecommendations": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 }
      }
    },
    "images": {
      "type": "array",
      "items": { "$ref": "#/$defs/image" }
    },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/group" }
    },
    "errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/error" }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256",
        "format",
        "width",
        "height",
        "aspectRatio",
        "hasAlpha",
        "fileSizeBytes",
        "metadata",
        "quality",
        "warnings"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "absolutePath": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "format": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "exclusiveMinimum": 0 },
        "height": { "type": "integer", "exclusiveMinimum": 0 },
        "aspectRatio": { "type": "number", "exclusiveMinimum": 0 },
        "hasAlpha": { "type": "boolean" },
        "bitDepth": { "type": "integer", "exclusiveMinimum": 0 },
        "fileSizeBytes": { "type": "integer", "minimum": 0 },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exifPresent", "iptcPresent", "xmpPresent", "iccPresent"],
          "properties": {
            "exifPresent": { "type": "boolean" },
            "iptcPresent": { "type": "boolean" },
            "xmpPresent": { "type": "boolean" },
            "iccPresent": { "type": "boolean" },
            "captureDate": { "type": "string" },
            "cameraMake": { "type": "string" },
            "cameraModel": { "type": "string" },
            "copyright": { "type": "string" },
            "creator": { "type": "string" }
          }
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "detailScore": { "type": "number" },
            "sharpnessScore": { "type": "number" },
            "compressionScore": { "type": "number" },
            "noiseScore": { "type": "number" },
            "probableUpscale": { "type": "boolean" },
            "probableRecompression": { "type": "boolean" }
          }
        },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "thumbnail": { "type": "string", "minLength": 1 },
            "centerCrop": { "type": "string", "minLength": 1 },
            "detailCrop": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["a", "b", "relationship", "confidence", "reasons"],
      "properties": {
        "a": { "type": "string", "minLength": 1 },
        "b": { "type": "string", "minLength": 1 },
        "relationship": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "details": { "type": "object" }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "members",
        "comparisons",
        "confidence",
        "status",
        "reasons",
        "warnings"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["exact-duplicate", "visual"] },
        "members": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "comparisons": { "type": "array", "items": { "$ref": "#/$defs/comparison" } },
        "recommendedOriginalId": { "type": "string", "minLength": 1 },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "enum": ["automatic", "manual-review", "approved", "rejected", "ambiguous"] },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "operation", "error", "continued"],
      "properties": {
        "phase": { "type": "string", "minLength": 1 },
        "filePath": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "error": { "type": "string", "minLength": 1 },
        "continued": { "type": "boolean" },
        "remediation": { "type": "string", "minLength": 1 }
      }
    }
  }
}
